{
  "name": "@vited/cli",
  "version": "0.1.4",
  "description": "CLI for Vited documentation sites",
  "homepage": "https://github.com/vitedjs/cli#readme",
  "bugs": {
    "url": "https://github.com/vitedjs/cli/issues"
  },
  "license": "MPL-2.0",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitedjs/cli.git"
  },
  "bin": {
    "vited": "./dist/bin/cli.mjs"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@guoyunhe/oxfmt-config": "^1.1.0",
    "@types/node": "^22.15.30",
    "@vited/core": "link:../core",
    "@vited/theme-mantine": "link:../theme-mantine",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-config-recommended": "^1.1.0",
    "tsdown": "^0.23.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@vited/core": "^0.4.0",
    "vite": "^8.3.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.css": "oxfmt --write",
    "*.{json,jsonc,scss,less,htm,html,md,mdx,yaml,yml}": "oxfmt --write"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=12.14.0",
      "onFail": "error"
    }
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
