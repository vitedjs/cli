{
  "name": "@vited/cli",
  "version": "0.1.0",
  "description": "CLI for Vited documentation sites",
  "homepage": "https://github.com/vitedjs/cli#readme",
  "bugs": {
    "url": "https://github.com/vitedjs/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitedjs/cli.git"
  },
  "license": "MIT",
  "author": {
    "name": "Guo Yunhe",
    "email": "i@guoyunhe.me"
  },
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "bin": {
    "vited": "./dist/bin/cli.mjs"
  },
  "files": ["dist", "CHANGELOG.md", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  },
  "dependencies": {
    "commander": "^14.0.0"
  },
  "peerDependencies": {
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "tsdown": "^0.23.2",
    "typescript": "^5.8.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
